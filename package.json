{
  "name": "pmtpeg",
  "version": "0.0.1",
  "description": "Utility library for parsing, inspecting and debugging pmtiles map files",
  "license": "MIT",
  "repository": "github:spencermountain/pmtpeg",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./builds/pmtpeg.d.cts",
        "default": "./builds/pmtpeg.cjs"
      },
      "import": {
        "types": "./builds/pmtpeg.d.ts",
        "browser": "./builds/pmtpeg.browser.js",
        "default": "./builds/pmtpeg.js"
      },
      "default": {
        "types": "./builds/pmtpeg.d.ts",
        "browser": "./builds/pmtpeg.browser.js",
        "default": "./builds/pmtpeg.js"
      }
    }
  },
  "main": "./builds/pmtpeg.cjs",
  "types": "./builds/pmtpeg.d.cts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "watch": "node scratch.js",
    "build": "rolldown -c",
    "lint": "eslint ."
  },
  "files": [
    "builds"
  ],
  "keywords": [
    "pmtiles",
    "maps",
    "mvt",
    "vector-tiles",
    "protomaps",
    "tippecanoe"
  ],
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "pbf": "5.1.2"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "rolldown": "^1.2.9"
  }
}
